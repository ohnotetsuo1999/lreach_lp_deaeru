{
  "code": "lp100a",
  "title": "出会えるエージェント｜エージェント診断",
  "design": "<!doctype html>\n<html lang=\"ja\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>出会えるエージェント｜転職こそ、タイパの時代。</title>\n    <style>\n      :root { color-scheme: light; }\n      * { box-sizing: border-box; }\n      html { scroll-behavior: smooth; }\n      body { margin: 0; background: #f1f3f2; color: #121827; font-family: -apple-system, BlinkMacSystemFont, \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", sans-serif; }\n      .page { width: min(100%, 640px); margin: 0 auto; background: #fff; box-shadow: 0 12px 50px #11182712; }\n      .hero { position: relative; }\n      .slice { display: block; width: 100%; height: auto; }\n      .hero-cta { position: absolute; bottom: 7%; left: 9%; width: 82%; display: block; border-radius: 999px; transition: transform .2s ease; }\n      .hero-cta:hover, .floating-cta:hover { transform: translateY(-3px); }\n      .hero-cta img, .floating-cta img { display: block; width: 100%; height: auto; }\n      .form-section { padding: 46px 26px 64px; background: linear-gradient(180deg, #e8fff1, #fff 32%); scroll-margin-top: 16px; }\n      .form-heading { margin: 0 0 8px; text-align: center; color: #101827; font-size: clamp(24px, 5vw, 32px); line-height: 1.45; }\n      .form-lead { margin: 0 auto 26px; max-width: 34em; text-align: center; font-size: 15px; line-height: 1.8; }\n      .form-card { padding: 28px; border: 1px solid #d9e8df; border-radius: 20px; background: #fff; box-shadow: 0 18px 40px #164a2920; }\n      #lreach-form { display: grid; gap: 18px; }\n      #lreach-form h2 { margin: 0 0 2px; font-size: 22px; line-height: 1.5; }\n      #lreach-form > label { display: grid; gap: 7px; font-size: 15px; font-weight: 700; }\n      #lreach-form input:not([type=\"checkbox\"]), #lreach-form select { display: block; width: 100%; min-width: 0; padding: 13px; border: 1px solid #a9bdb1; border-radius: 8px; background: #fff; color: #121827; font: inherit; font-weight: 400; }\n      #lreach-form fieldset { display: flex; gap: 10px 16px; flex-wrap: wrap; margin: 0; padding: 16px; border: 1px solid #a9bdb1; border-radius: 8px; }\n      #lreach-form legend { padding: 0 5px; font-weight: 700; }\n      #lreach-form fieldset label { display: inline-flex; gap: 5px; align-items: center; }\n      #lreach-form button { min-height: 56px; border: 0; border-radius: 999px; background: linear-gradient(#ff741d, #e85600); box-shadow: 0 5px 0 #b74000; color: #fff; font: inherit; font-size: 17px; font-weight: 800; cursor: pointer; }\n      #lreach-form button:disabled { opacity: .65; cursor: wait; }\n      #lreach-status { min-height: 1.5em; margin: 0; color: #b42318; }\n      :focus-visible { outline: 3px solid #0aaf60; outline-offset: 4px; }\n      .footer { padding: 18px 22px 95px; background: #fff; text-align: center; font-size: 13px; }\n      .footer a { color: #254d3a; text-underline-offset: 3px; }\n      .floating-cta { position: fixed; z-index: 10; bottom: max(12px, env(safe-area-inset-bottom)); left: 50%; width: min(calc(100% - 28px), 560px); transform: translateX(-50%); filter: drop-shadow(0 5px 9px #0004); }\n      .floating-cta[hidden] { display: none; }\n      .floating-cta:hover { transform: translate(-50%, -3px); }\n      @media (max-width: 480px) { .form-section { padding: 34px 16px 56px; } .form-card { padding: 20px; } #lreach-form h2 { font-size: 20px; } }\n      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .hero-cta, .floating-cta { transition: none; } }\n    </style>\n  </head>\n  <body>\n    <main class=\"page\">\n      <section class=\"hero\" aria-label=\"出会えるエージェントのご案内\">\n        <img class=\"slice\" src=\"/deaeru-lp99a-intro.png\" alt=\"出会えるエージェント。転職こそ、タイパの時代。希望条件をもとにエージェントを紹介します。\">\n        <a class=\"hero-cta\" href=\"#consultation\" aria-label=\"エージェント診断フォームへ進む\">\n          <img src=\"/deaeru-lp99a-cta-button.png\" alt=\"エージェント診断 START\">\n        </a>\n      </section>\n      <section aria-label=\"サービスのご案内\">\n        <img class=\"slice\" src=\"/deaeru-lp02a-slice1.png\" alt=\"転職するべきか悩んでいる、紹介される求人に納得できない、といったお悩み\">\n        <img class=\"slice\" src=\"/deaeru-lp02a-slice2.png\" alt=\"\">\n        <img class=\"slice\" src=\"/deaeru-lp02a-slice3.png\" alt=\"\">\n        <img class=\"slice\" src=\"/deaeru-lp02a-slice4.png\" alt=\"\">\n        <img class=\"slice\" src=\"/deaeru-lp02a-slice5.png\" alt=\"\">\n        <img class=\"slice\" src=\"/deaeru-lp02a-slice6.png\" alt=\"\">\n      </section>\n      <section class=\"form-section\" id=\"consultation\" aria-label=\"エージェント診断フォーム\">\n        <h1 class=\"form-heading\">あなたに合うエージェントを探す</h1>\n        <p class=\"form-lead\">希望する働き方を入力して、次の案内へ進んでください。</p>\n        <div class=\"form-card\">{{LREACH_FORM}}</div>\n      </section>\n      <img class=\"slice\" src=\"/deaeru-lp02a-slice7.png\" alt=\"\">\n      <footer class=\"footer\"><a href=\"https://foresma.jp/\" target=\"_blank\" rel=\"noopener noreferrer\">運営会社</a></footer>\n    </main>\n    <a class=\"floating-cta\" href=\"#consultation\" aria-label=\"エージェント診断フォームへ進む\" hidden><img src=\"/deaeru-lp99a-cta-button.png\" alt=\"エージェント診断 START\"></a>\n    <script>\n      (() => {\n        const hero = document.querySelector('.hero-cta');\n        const form = document.querySelector('#consultation');\n        const floating = document.querySelector('.floating-cta');\n        if (!hero || !form || !floating || !('IntersectionObserver' in window)) return;\n        let heroVisible = true;\n        let formVisible = false;\n        const update = () => { floating.hidden = heroVisible || formVisible; };\n        new IntersectionObserver(([entry]) => { heroVisible = entry.isIntersecting; update(); }).observe(hero);\n        new IntersectionObserver(([entry]) => { formVisible = entry.isIntersecting; update(); }).observe(form);\n      })();\n    </script>\n  </body>\n</html>\n",
