atch-badge{position:absolute;right:-19px;top:-20px;background:#ffd83a;padding:11px 17px;border-radius:99px;font-size:12px;font-weight:900;box-shadow:0 7px 14px #0002;transform:rotate(9deg)}\n    .band{background:linear-gradient(120deg,#08c856,#039d42);color:white;text-align:center;padding:49px 20px}.band h2{font-size:clamp(27px,4vw,45px);margin:0 0 12px}.band p{font-size:clamp(15px,2vw,20px);line-height:1.7;margin:0}.section{padding:86px 0}.muted{background:#f7faf8}.problem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-top:38px}.problem-card,.feature-card{background:#fff;border:1px solid #e5eee7;border-radius:20px;box-shadow:0 10px 25px #103b2510}.problem-card{padding:25px}.problem-icon{font-size:27px}.problem-card h3{font-size:17px;margin:15px 0 8px}.problem-card p,.feature-card p{font-size:13px;line-height:1.8;color:#607067;margin:0}.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:19px;margin-top:40px}.feature-card{padding:28px}.feature-no{display:inline-grid;place-items:center;width:37px;height:37px;background:#e0f9e9;color:#089f45;border-radius:50%;font-weight:900}.feature-card img{display:block;height:145px;margin:15px auto;object-fit:contain}.feature-card h3{margin:17px 0 10px;font-size:18px}.flow-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:36px}.flow-step{background:white;border:1px solid #dcece1;border-radius:18px;padding:25px;position:relative}.flow-step strong{color:#069f46;font-size:13px}.flow-step h3{font-size:18px;margin:12px 0 7px}.flow-step p{font-size:13px;line-height:1.8;margin:0;color:#607067}.faq-list{max-width:790px;margin:34px auto 0}.faq-list details{background:white;border:1px solid #e2ebe5;border-radius:13px;margin:12px 0;padding:0 20px}.faq-list summary{cursor:pointer;padding:19px 0;font-weight:800;list-style:none}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary:before{content:\"Q.\";color:#00a348;margin-right:10px}.faq-list details p{border-top:1px solid #edf0ed;margin:0;padding:15px 0 20px;font-size:14px;line-height:1.8;color:#526158}\n    .form-area{padding:75px 0 90px;background:linear-gradient(#e8faee,#fff 55%);scroll-margin-top:70px}.form-wrap{max-width:710px;margin:auto}.form-card{margin-top:30px;background:#fff;border:1px solid #d8eadd;border-radius:22px;padding:35px;box-shadow:0 20px 45px #15452a1e}#lreach-form{display:grid;gap:19px}#lreach-form h2{font-size:24px;margin:0}#lreach-form>label{display:grid;gap:8px;font-weight:700;font-size:14px}#lreach-form input:not([type=checkbox]),#lreach-form select{width:100%;padding:13px;border:1px solid #a9bdb1;border-radius:8px;background:white;color:#17231d}#lreach-form fieldset{border:1px solid #a9bdb1;border-radius:8px;display:flex;flex-wrap:wrap;gap:12px;padding:15px}#lreach-form legend{font-weight:700}#lreach-form fieldset label{display:inline-flex;align-items:center;gap:5px}#lreach-form button{border:0;border-radius:99px;background:linear-gradient(120deg,#ff8126,#ed5a0b);color:white;padding:18px;font-size:17px;font-weight:900;cursor:pointer}#lreach-form button:disabled{opacity:.6;cursor:wait}#lreach-status{margin:0;color:#b42318;min-height:1.4em}.footer{padding:38px 0;border-top:1px solid #e9efea;font-size:13px;color:#667369}.footer .wrap{display:flex;justify-content:space-between;align-items:center;gap:20px}.footer img{width:150px}.footer a{text-decoration:underline;text-underline-offset:3px}.floating-cta{display:none}\n    :focus-visible{outline:3px solid #008d40;outline-offset:4px}@media(max-width:800px){.nav a:not(.nav-cta){display:none}.hero-grid{grid-template-columns:1fr;gap:15px}.hero{padding:49px 0 60px}.hero-copy{text-align:center}.hero h1{font-size:clamp(42px,9vw,62px)}.hero-points{justify-content:center}.hero-visual{min-height:290px}.hero-orbit{width:265px;height:265px}.match-card{width:280px;padding:22px}.match-card h2{font-size:22px;margin-bottom:15px}.match-row{padding:8px;margin:5px 0}.match-badge{right:-5px}.problem-grid{grid-template-columns:repeat(2,1fr)}.feature-grid{grid-template-columns:1fr}.feature-card{display:grid;grid-template-columns:120px 1fr;gap:0 19px;align-items:center}.feature-card .feature-no{grid-column:1}.feature-card img{grid-column:1;grid-row:2/4;width:120px;height:100px;margin:0}.feature-card h3,.feature-card p{grid-column:2}.flow-grid{grid-template-columns:1fr}.flow-grid[style]{grid-template-columns:1fr!important}.section{padding:62px 0}}@media(max-width:520px){.wrap{width:min(100% - 32px,1120px)}.site-header .nav-cta{font-size:11px;padding:10px 12px}.logo{width:138px}.hero-lead{font-size:14px}.hero-points span{font-size:11px}.cta{width:100%;font-size:15px;padding:17px}.hero-visual{min-height:290px}.problem-card{padding:17px}.problem-card h3{font-size:14px}.problem-card p{font-size:12px}.feature-card{display:block}.feature-card img{height:115px;margin:8px auto}.form-card{padding:21px}.footer .wrap{display:block;text-align:center}.footer img{display:block;margin:0 auto 15px}.floating-cta{display:block;position:fixed;z-index:19;bottom:max(13px,env(safe-area-inset-bottom));left:16px;right:16px;text-align:center;background:linear-gradient(120deg,#ff8126,#ed5a0b);color:white;border-radius:99px;padding:15px;font-size:14px;font-weight:900;text-decoration:none;box-shadow:0 6px 18px #0003}.floating-cta[hidden]{display:none}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.cta{transition:none}}\n  </style>\n</head>\n<body>\n  <header class=\"site-header\"><div class=\"wrap header-inner\"><a href=\"#top\" aria-label=\"ページ先頭へ\"><img class=\"logo\" src=\"/issued-assets/lp01a-inspired/logo.png\" alt=\"出会えるエージェント\"></a><nav class=\"nav\" aria-label=\"ページ内ナビゲーション\"><a href=\"#problem\">お悩み</a><a href=\"#features\">解決策</a><a href=\"#reasons\">選ばれる理由</a><a href=\"#faq\">よくある質問</a><a class=\"nav-cta\" href=\"#consultation\">無料相談スタート</a></nav></div></header>\n  <main id=\"top\">\n    <section class=\"hero\"><div class=\"wrap hero-grid\"><div class=\"hero-copy\"><h1><small>出会えるエージェント</small>出会える。<br><span class=\"green\">いい人</span>に、<br><span class=\"green\">いい求人</span>に。</h1><div class=\"hero-points\"><span>希望に合わせて相談</span><span>エージェント選びをサポート</span></div><p class=\"hero-lead\">転職は、これからの働き方を決める大切な選択。<br>まずは希望を整理して、相談のきっかけをつくりませんか。</p><a class=\"cta\" href=\"#consultation\">あなたに合うエージェントを診断する</a><p class=\"hero-meta\">利用料無料 ／ かんたん入力</p></div><div class=\"hero-visual\" aria-hidden=\"true\"><div class=\"hero-orbit\"></div><div class=\"match-card\"><span class=\"match-badge\">自分に合う相談先を</span><h2>あなたの希望から<br>はじめよう。</h2><div class=\"match-row\"><span class=\"match-icon\">💬</span><div><b>希望を伝える</b><small>働き方や勤務地を入力</small></div></div><div class=\"match-row\"><span class=\"match-icon\">🔎</span><div><b>案内を選ぶ</b><small>自分に合う進め方を確認</small></div></div><div class=\"match-row\"><span class=\"match-icon\">🤝</span><div><b>相談へ進む</b><small>LINEで次のご案内へ</small></div></div></div></div></div></section>\n    <section class=\"band\"><h2>出会えるエージェントなら</h2><p>あなたの希望に耳を傾け、<br>次の一歩を考えるお手伝いをします。</p></section>\n    <section class=\"section muted\" id=\"problem\"><div class=\"wrap\"><div class=\"center\"><span class=\"eyebrow\">Problem</span><h2 class=\"section-title\">転職活動でこんな悩みはありませんか？</h2><p class=\"section-lead\">一人で考え続ける前に、希望と不安を整理してみましょう。</p></div><div class=\"problem-grid\"><article class=\"problem-card\"><div class=\"problem-icon\">📉</div><h3>自分の市場価値がわからない</h3><p>今の経験を、次の仕事でどう活かせるか知りたい。</p></article><article class=\"problem-card\"><div class=\"problem-icon\">🔍</div><h3>相談相手を選べない</h3><p>どのエージェントに相談すればよいか迷っている。</p></article><article class=\"problem-card\"><div class=\"problem-icon\">🏢</div><h3>求人だけでは判断しにくい</h3><p>仕事内容や働き方を、もう少し詳しく確かめたい。</p></article><article class=\"problem-card\"><div class=\"problem-icon\">🎯</div><h3>準備の進め方に迷う</h3><p>応募や面接の前に、方向性を整理したい。</p></article></div></div></section>\n    <section class=\"section\" id=\"features\"><div class=\"wrap\"><div class=\"center\"><span class=\"eyebrow\">Solution</span><h2 class=\"section-title\">これらの課題を、<span class=\"green\">相談から解決へ。</span></h2><p class=\"section-lead\">転職活動の方向性を考えるために、まず希望を整理しましょう。</p></div><div class=\"feature-grid\"><article class=\"feature-card\"><span class=\"feature-no\">01</span><img src=\"/issued-assets/lp01a-inspired/selecting-team.svg\" alt=\"\" aria-hidden=\"true\"><h3>希望を整理する</h3><p>働きたい場所や今後の希望を入力して、考えを言葉にできます。</p></article><article class=\"feature-card\"><span class=\"feature-no\">02</span><img src=\"/issued-assets/lp01a-inspired/online-consulting.svg\" alt=\"\" aria-hidden=\"true\"><h3>相談方法を選ぶ</h3><p>LINE追加後に案内方法を確認し、自分に合う進め方を選べます。</p></article><article class=\"feature-card\"><span class=\"feature-no\">03</span><img src=\"/issued-assets/lp01a-inspired/hired.svg\" alt=\"\" aria-hidden=\"true\"><h3>仕事を知る</h3><p>求人の条件だけでなく、仕事内容や働き方も確かめながら考えられます。</p></article><article class=\"feature-card\"><span class=\"feature-no\">04</span><img src=\"/issued-assets/lp01a-inspired/selecting-team.svg\" alt=\"\" aria-hidden=\"true\"><h3>次の一歩へ</h3><p>応募や面接で気になっていることを、相談しながら整理できます。</p></article></div></div></section>\n    <section class=\"section\" id=\"reasons\"><div class=\"wrap\"><div class=\"center\"><span class=\"eyebrow\">Why choose us</span><h2 class=\"section-title\">相談をはじめやすい、2つの理由</h2></div><div class=\"flow-grid\" style=\"grid-template-columns:repeat(2,1fr)\"><div class=\"flow-step\"><strong>01</strong><h3>希望から考えられる</h3><p>今の状況や働きたい場所を入力し、相談したいことを整理できます。</p></div><div class=\"flow-step\"><strong>02</strong><h3>LINEで案内方法を選べる</h3><p>回答後はLINEへ進み、案内方法を選択できます。</p></div></div></div></section>\n    <section class=\"section muted\"><div class=\"wrap\"><div class=\"center\"><span class=\"eyebrow\">How it works</span><h2 class=\"section-title\">ご利用の流れ</h2></div><div class=\"flow-grid\"><div class=\"flow-step\"><strong>STEP 01</strong><h3>希望を入力</h3><p>お名前、希望勤務地などを入力します。</p></div><div class=\"flow-step\"><strong>STEP 02</strong><h3>LINEへ進む</h3><p>回答後にLINEのご案内を確認します。</p></div><div class=\"flow-step\"><strong>STEP 03</strong><h3>案内方法を選ぶ</h3><p>LINE追加後、案内方法を選んで進みます。</p></div></div></div></section>\n    <section class=\"section\" id=\"faq\"><div class=\"wrap\"><div class=\"center\"><span class=\"eyebrow\">FAQ</span><h2 class=\"section-title\">よくある質問</h2></div><div class=\"faq-list\"><details><summary>利用に料金はかかりますか？</summary><p>求職者の方は無料でご利用いただけます。</p></details><details><summary>今すぐ転職する予定がなくても利用できますか？</summary><p>まず希望を整理したい方も、ご自身の状況に合わせてご相談ください。</p></details><details><summary>回答した後はどうなりますか？</summary><p>入力内容を送信するとLINEの案内へ進みます。LINE追加後に、案内方法を選べます。</p></details></div></div></section>\n    <section class=\"form-area\" id=\"consultation\"><div class=\"wrap form-wrap\"><div class=\"center\"><span class=\"eyebrow\">Start</span><h2 class=\"section-title\">あなたに合う相談の一歩を。</h2><p class=\"section-lead\">希望を入力して、次の案内へ進んでください。</p></div><div class=\"form-card\"><div data-lreach-form-placeholder>{{LREACH_FORM}}</div></div></div></section>\n  </main>\n  <footer class=\"footer\"><div class=\"wrap\"><img src=\"/issued-assets/lp01a-inspired/logo.png\" alt=\"出会えるエージェント\"><a href=\"https://foresma.jp/\" target=\"_blank\" rel=\"noopener noreferrer\">運営会社</a></div></footer>\n  <a class=\"floating-cta\" href=\"#consultation\" hidden>あなたに合うエージェントを診断する →</a>\n  <script>(()=>{const hero=document.querySelector('.hero .cta'),form=document.querySelector('#consultation'),floating=document.querySelector('.floating-cta');if(!hero||!form||!floating||!('IntersectionObserver'in window))return;let heroVisible=true,formVisible=false;const update=()=>{floating.hidden=heroVisible||formVisible};new IntersectionObserver(([entry])=>{heroVisible=entry.isIntersecting;update()}).observe(hero);new IntersectionObserver(([entry])=>{formVisible=entry.isIntersecting;update()}).observe(form)})();</script>\n<script data-lreach-file-preview>\nif (location.protocol === 'file:') {\n  document.querySelectorAll('img[src^=\"/\"]').forEach(image => {\n    image.src = new URL('../public' + image.getAttribute('src'), location.href).href;\n  });\n  document.querySelector('[data-lreach-form-placeholder]').innerHTML =\n    '<form id=\"lreach-form\" aria-label=\"表示確認用フォーム\">' +\n    '<h2>' + \"出会えるエージェント診断\" + '</h2>' +\n    '<label>お名前<input disabled></label>' +\n    '<label>性別<select disabled><option>選択してください</option></select></label>' +\n    '<label>生まれ年<input disabled></label>' +\n    '<fieldset disabled><legend>希望勤務地（1つ以上）</legend>' +\n    '<label><input type=\"checkbox\">東京都</label><label><input type=\"checkbox\">神奈川県</label>' +\n    '<label><input type=\"checkbox\">埼玉県</label><label><input type=\"checkbox\">千葉県</label></fieldset>' +\n    '<label>電話番号<input disabled></label>' +\n    '<button disabled>回答してLINEへ進む</button>' +\n    '<p>表示確認用です。発行後のページで回答できます。</p></form>';\n}\n</script></body>\n</html>\n",
