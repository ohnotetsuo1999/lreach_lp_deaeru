NEXT_PUBLIC_LREACH_BACKEND_URL=https://your-lreach-backend.example
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_DEAERU_GATEWAY_URL=https://lreach-gateway-dev.vercel.app/
